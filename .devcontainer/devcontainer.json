{
  "name": "Banking System (Java 17 + Maven + desktop for JavaFX)",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installMaven": "true" },
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": { "6080": { "label": "Desktop (JavaFX window)", "onAutoForward": "notify" } },
  "containerEnv": { "DISPLAY": ":1" },
  "postCreateCommand": "mvn -q -DskipTests dependency:resolve",
  "customizations": { "vscode": { "extensions": ["vscjava.vscode-java-pack"] } }
}
